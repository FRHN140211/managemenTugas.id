DATABASE_URL=postgresql://USER:***@HOST/DATABASE?sslmode=require
# Test/integration database (isolated Neon project/branch, e.g. project "neondb_test",
# database "neondb_test"). Copy the real connection string from Neon Console -> Connect.
# Never commit this value; .env.local is git-ignored.
TEST_DATABASE_URL=postgresql://USER:***@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=
ACTIVITY_TIMEZONE=Asia/Jakarta

# --- Email Service ---
# EMAIL_PROVIDER: resend | smtp | mock
EMAIL_PROVIDER=mock
# From address for all outgoing emails
EMAIL_FROM=noreply@yourdomain.com
# Reply-to address
EMAIL_REPLY_TO=
# Resend (for production email)
RESEND_API_KEY=
# SMTP (alternative for production email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Redis Rate Limiting ---
# Rate limit backend: redis | database | memory
RATE_LIMIT_BACKEND=memory
# Upstash Redis REST (for distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis URL (alternative)
REDIS_URL=
REDIS_HOST=

# --- Application ---
# Base URL of the application (used in email templates)
APP_BASE_URL=http://localhost:3000
# Node environment
NODE_ENV=development
