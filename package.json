    "c8": "^12.0.0",
    "depcheck": "^1.4.7",
    "husky": "^9.1.7",
    "playwright": "^1.48.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "vite": "^6.4.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run depcheck"
    }
  },
